<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 检查更新：连 GitHub 下载新版本，用系统安装器安装 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- 本地存储根目录“豆包输入法无障碍”文件夹导入导出（备份、解释词库、音效） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- 需要能“看见”豆包输入法与主流读屏，才能同步设置并代理读屏穿透/控制接口 -->
    <queries>
        <package android:name="com.bytedance.android.doubaoime" />
        <package android:name="com.android.tback" />
        <package android:name="com.nirenr.talkman" />
        <package android:name="com.bjbyhd.voiceback" />
        <package android:name="com.bjbyhd.screenreader" />
        <package android:name="com.dianming.phoneapp" />
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="tatans.intent.action.IME_SERVICE" /></intent>
        <intent><action android:name="com.dianming.phoneapp.SpeakServiceForApp" /></intent>
        <!-- Android 11+ 包可见性：用于识别并定向授权系统 APK 安装器 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:scheme="content" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name=".SettingsProvider"
            android:authorities="io.github.doubaoa11y.settings"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- 只切换桌面入口；SettingsActivity 保留模块管理器的设置入口。 -->
        <activity-alias
            android:name=".ui.LauncherAlias"
            android:targetActivity=".ui.SettingsActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/xposed_description" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
    </application>
</manifest>
